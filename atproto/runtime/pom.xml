<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sitenetsoft.quarkus</groupId>
    <artifactId>quarkus-social-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>quarkus-social-atproto</artifactId>
  <name>Quarkus Social AT Protocol - Runtime</name>
  <description>Publishes quarkus-social posts to Bluesky and Standard.site through quarkus-atproto</description>
  <dependencies>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-social</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>quarkus-atproto-oauth</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicons-bsky</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.sitenetsoft.quarkus</groupId><artifactId>atproto-lexicons-standard-site</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-extension-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>compile</phase>
            <goals><goal>extension-descriptor</goal></goals>
            <configuration>
              <deployment>${project.groupId}:${project.artifactId}-deployment:${project.version}</deployment>
              <!-- activated as a conditional dependency of quarkus-social when the app has quarkus-atproto-oauth -->
              <dependencyCondition>
                <extension>org.sitenetsoft.quarkus:quarkus-atproto-oauth</extension>
              </dependencyCondition>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><artifactId>maven-compiler-plugin</artifactId></plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
